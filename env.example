# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=smart_alert_db
DB_SSLMODE=disable

# Database URL (alternatif, jika sudah lengkap)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_alert_db?sslmode=disable

# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# AI Configuration (Google Gemini via OpenAI-compatible endpoint)
# Dapatkan API Key dari: https://aistudio.google.com/apikey
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.0-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Application Configuration
APP_ENV=development
APP_PORT=8080
TIMEZONE=Asia/Jakarta

# Redis For Asynq Message Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Scheduler Configuration
MORNING_ALERT_TIME=05:00
EVENING_SUMMARY_TIME=22:00
